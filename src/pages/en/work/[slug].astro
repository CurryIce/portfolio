---
import Case from '../../../views/Case.astro';
import { getContent, type Project } from '../../../lib/content';
export function getStaticPaths() { return getContent('en').projects.map(project => ({ params: {slug: project.slug}, props: {project} })); }
interface Props { project: Project; }
const { project } = Astro.props;
---
<Case project={project} lang="en" />
